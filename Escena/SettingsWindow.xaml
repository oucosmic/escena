<Window x:Class="Escena.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ajustos" Width="560" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Icon="/Escena.ico"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}">
    <StackPanel Margin="16">
        <TextBlock Text="D'AQUEST ESPECTACLE" Style="{StaticResource SectionHeader}"/>

        <TextBlock Text="Protecció de doble GO (ms) — s'ignoren els GO que arribin abans" Style="{StaticResource FieldLabel}"/>
        <TextBox x:Name="LockoutBox" Width="120" HorizontalAlignment="Left"/>

        <TextBlock Text="PÀNIC: durada de la fosa del primer toc (s) — el segon toc talla de cop" Style="{StaticResource FieldLabel}"/>
        <TextBox x:Name="PanicBox" Width="120" HorizontalAlignment="Left"/>

        <TextBlock Text="Còpia de seguretat dels canvis sense desar, cada (s)" Style="{StaticResource FieldLabel}"/>
        <TextBox x:Name="AutosaveBox" Width="120" HorizontalAlignment="Left"/>

        <TextBlock Text="D'AQUEST ORDINADOR" Style="{StaticResource SectionHeader}" Margin="0,22,0,6"/>
        <TextBlock Text="Sortida per escoltar cues (🎧 Escolta / tecla E)" Style="{StaticResource FieldLabel}"/>
        <ComboBox x:Name="PreviewCombo" DisplayMemberPath="Name" SelectedValuePath="Id"/>
        <TextBlock x:Name="PreviewWarning" Foreground="#A9B4C2" TextWrapping="Wrap" Margin="0,6,0,0" FontSize="12"/>

        <TextBlock Text="Idioma de la interfície (s'aplica en tornar a obrir Escena)" Style="{StaticResource FieldLabel}"/>
        <ComboBox x:Name="LanguageCombo" DisplayMemberPath="Label" SelectedValuePath="Value" Width="200" HorizontalAlignment="Left"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="D'acord" Width="100" Click="Ok_Click"/>
            <Button Content="Cancel·la" Width="100" Click="Cancel_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
