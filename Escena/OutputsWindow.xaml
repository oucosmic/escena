<Window x:Class="Escena.OutputsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Escena"
        Title="Sortides" Width="820" Height="700" ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Icon="/Escena.ico"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="14"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="SORTIDES" Style="{StaticResource SectionHeader}"/>
            <WrapPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                <Button Content="+ Àudio" Click="AddAudio_Click"/>
                <Button Content="+ Pantalla" Click="AddVideo_Click"/>
                <Button Content="Elimina" Click="Remove_Click"/>
            </WrapPanel>
            <ListBox x:Name="OutputList" DisplayMemberPath="ListLabel" SelectionChanged="OutputList_SelectionChanged"
                     Background="{StaticResource PanelBrush}" Foreground="{StaticResource TextBrush}"
                     BorderBrush="{StaticResource BorderBrush}" FontSize="14"/>
        </DockPanel>

        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" Focusable="False">
        <StackPanel Margin="0,0,8,0">
            <TextBlock Text="Nom" Style="{StaticResource FieldLabel}" Margin="0,0,0,3"/>
            <TextBox x:Name="NameBox" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>

            <!-- Àudio -->
            <StackPanel x:Name="AudioEditor">
                <TextBlock Text="Controlador" Style="{StaticResource FieldLabel}"/>
                <ComboBox x:Name="DriverCombo" ItemsSource="{x:Static local:Options.Drivers}"
                          SelectedValuePath="Value" DisplayMemberPath="Label"
                          SelectedValue="{Binding Driver}" SelectionChanged="DriverCombo_SelectionChanged"/>

                <TextBlock Text="Dispositiu" Style="{StaticResource FieldLabel}"/>
                <ComboBox x:Name="DeviceCombo" SelectedValuePath="Id" DisplayMemberPath="Name"
                          SelectedValue="{Binding DeviceId}"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Latència WASAPI (ms)" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding LatencyMs, UpdateSourceTrigger=LostFocus}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Canal ASIO inicial (0 = 1-2)" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding AsioChannelOffset, UpdateSourceTrigger=LostFocus}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Ajust de volum (dB)" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding TrimDb, UpdateSourceTrigger=LostFocus}"/>
                    </StackPanel>
                </Grid>
                <TextBlock Text="Canals (0 = automàtic). En WASAPI compartit s'usen sempre els del dispositiu; en exclusiu i ASIO, els que diguis aquí." Style="{StaticResource FieldLabel}" TextWrapping="Wrap"/>
                <TextBox Text="{Binding Channels, UpdateSourceTrigger=LostFocus}" Width="100" HorizontalAlignment="Left"/>
                <Button Content="🔊 Prova de so (1 s)" HorizontalAlignment="Left" Margin="0,16,0,0" Click="Test_Click"/>
            </StackPanel>

            <!-- Vídeo -->
            <StackPanel x:Name="VideoEditor">
                <TextBlock Text="Pantalla" Style="{StaticResource FieldLabel}"/>
                <ComboBox x:Name="ScreenCombo" SelectedValuePath="DeviceName" DisplayMemberPath="Label"
                          SelectedValue="{Binding ScreenId}" SelectionChanged="ScreenCombo_SelectionChanged"/>
                <CheckBox Content="Pantalla completa (sense vores ni cursor)" IsChecked="{Binding Fullscreen}"/>
                <TextBlock x:Name="ScreenHint" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,0,0" FontSize="12"/>

                <TextBlock Text="Ajust de volum del so dels vídeos (dB)" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding TrimDb, UpdateSourceTrigger=LostFocus}" Width="100" HorizontalAlignment="Left"/>

                <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                    <Button Content="🖵 Mostra el nom a la pantalla" Click="Test_Click"/>
                    <Button Content="Identifica totes les pantalles" Click="Identify_Click"/>
                </StackPanel>
                <TextBlock Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,10,0,0" FontSize="12"
                           Text="La finestra de vídeo s'obre en negre en obrir l'espectacle i hi torna entre vídeos. Cada cue de vídeo tria per on surt el so («So del vídeo per»); aquest ajust de volum només afecta el que surt pel predeterminat de Windows."/>

                <TextBlock Text="CORRECCIÓ DEL PROJECTOR (cantonades, % de la pantalla)" Style="{StaticResource SectionHeader}" Margin="0,16,0,4"/>
                <StackPanel x:Name="CornerPanel"/>
            </StackPanel>

            <TextBlock x:Name="TestResult" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/>
        </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="D'acord" Width="100" Click="Ok_Click"/>
            <Button Content="Cancel·la" Width="100" Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
